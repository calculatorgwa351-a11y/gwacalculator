# Core runtime
APP_ENV=development
APP_PORT=5000
LOG_LEVEL=INFO

# Security (MUST be strong in production)
SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_NAME=access_token
COOKIE_SECURE=
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS / host filtering
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000
CORS_ALLOW_CREDENTIALS=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
ALLOW_SQLITE_IN_PRODUCTION=0

# Primary Postgres / Supabase config
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=6543
PGDATABASE=postgres
SUPABASE_SSL_NO_VERIFY=0

# Startup/bootstrap behavior
INIT_DB_ON_STARTUP=1
SEED_DEMO_DATA=0
DEMO_RESET_PASSWORDS=0
DEFAULT_ADMIN_SCHOOL_ID=admin
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_PASSWORD=adminpass

# Uvicorn
WEB_CONCURRENCY=2
